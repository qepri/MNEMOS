# Slim — no bundled llama.cpp, no GPU needed. Bring your own LLM server.
# Start with:  docker compose up -d          (llamacpp is excluded by default)
# Full stack:  docker compose --profile local-llm up -d
#
# LLM_PROVIDER=lm_studio is a generic OpenAI-compatible client — it works with
# Ollama, LM Studio, vLLM, llama-server. Do NOT use `custom` here: that path is
# connection-driven and raises "no active connection is selected" on a fresh
# install with no LLMConnection row.
#
# Point LOCAL_LLM_BASE_URL at your server. Use host.docker.internal, not
# localhost — inside a container localhost is the container itself.
#   Ollama:    http://host.docker.internal:11434/v1
#   LM Studio: http://host.docker.internal:1234/v1
LLM_PROVIDER=lm_studio
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1

# CPU embeddings: leaves the GPU entirely to your own LLM server. Explicit
# rather than `auto` so we don't silently claim VRAM the user wanted for Ollama.
EMBEDDING_DEVICE=cpu

# Deliberately does NOT set EMBEDDING_MODEL / EMBEDDING_DIMENSION. Changing the
# dimension requires dropping the chunks table and re-embedding everything, so
# slim mode must stay vector-compatible with whatever is already indexed.
