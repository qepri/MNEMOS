# Copy to .env.macos and fill in. Used by scripts/macos-native.sh (macOS, no containers).
# PostgreSQL with pgvector and Ollama run on the host; Redis is started by the script if it is not running.
DATABASE_URL=postgresql://mnemos_user:<password>@127.0.0.1:5432/mnemos_db
REDIS_URL=redis://127.0.0.1:6379/0
PYTHONUNBUFFERED=1
# LLM is optional: indexing and search work without one. With Ollama, use its OpenAI-compatible endpoint.
LLM_PROVIDER=llamacpp
LLAMACPP_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=llama3.2:3b
MEMORY_PROVIDER=llamacpp
HYPERGRAPH_LLM_PROVIDER=llamacpp
# Embeddings from Ollama (ollama pull bge-m3). EMBEDDING_DIMENSION must match the pgvector column.
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=cpu
EMBEDDING_USE_FP16=false
EMBEDDING_BATCH_SIZE=4
WHISPER_DEVICE=cpu
WHISPER_MODEL=base
CHUNK_SIZE=1024
CHUNK_OVERLAP=100
CELERY_POOL=solo
